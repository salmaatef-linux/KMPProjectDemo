CREATE TABLE noteEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    timestamp TEXT,
    isRemote INTEGER NOT NULL DEFAULT 0,
    isLocallyModified INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    isTombstone INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL DEFAULT 0
);

selectAllActiveNotes:
SELECT *
FROM noteEntity
WHERE isDeleted = 0 AND isTombstone = 0
ORDER BY updatedAt DESC, id DESC;

selectAllTrashedNotes:
SELECT *
FROM noteEntity
WHERE isDeleted = 1 AND isTombstone = 0
ORDER BY updatedAt DESC, id DESC;

selectNoteById:
SELECT *
FROM noteEntity
WHERE id = ?;

insertNote:
INSERT OR REPLACE INTO noteEntity(
    id,
    title,
    content,
    timestamp,
    isRemote,
    isLocallyModified,
    isDeleted,
    isTombstone,
    updatedAt,
    createdAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE noteEntity
SET title = ?,
    content = ?,
    isLocallyModified = 1,
    updatedAt = ?
WHERE id = ?;

setTrashState:
UPDATE noteEntity
SET isDeleted = ?,
    updatedAt = ?
WHERE id = ?;

markTombstone:
UPDATE noteEntity
SET isTombstone = 1,
    isDeleted = 0,
    updatedAt = ?
WHERE id = ?;

deleteNoteById:
DELETE FROM noteEntity
WHERE id = ?;

deleteAllNotes:
DELETE FROM noteEntity;
